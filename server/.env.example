# Copie para .env e preencha. NUNCA suba o .env para o git nem envie o token para o frontend.
PORT=3001

# Token do MYP Cards (gere em https://mypcards.com/acesso-api, depois de aprovado). Opcional:
# sem token o limite cai de 60 para 10 requisições por minuto.
MYP_API_TOKEN=

# Chave para as rotas /api/admin/* (deixe vazio para desativar o admin)
ADMIN_KEY=

# Origens permitidas por CORS, separadas por vírgula. Vazio = só mesma origem (use o proxy do Vite).
CORS_ORIGINS=

# Ajustes opcionais
# MYP_RATE_SAFETY=0.9        # usa 90% do limite oficial, como margem de segurança
# PRICE_TTL_MIN=30           # preço considerado fresco por 30 min (a API já cacheia 5 min)
# HISTORY_TTL_HOURS=6
# MAPPING_REFRESH_DAYS=30
